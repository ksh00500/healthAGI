# --- Database ---
POSTGRES_USER=healthagi
POSTGRES_PASSWORD=changeme
POSTGRES_DB=healthagi
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://healthagi:changeme@localhost:5432/healthagi
ALEMBIC_DATABASE_URL=postgresql+psycopg://healthagi:changeme@localhost:5432/healthagi

# --- Auth ---
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEXT_MODEL=gemma3:12b
LLM_VISION_MODEL=qwen2-vl:7b
LLM_VOICE_MODEL=gemma3:4b

# --- Object storage (MinIO) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=healthagi
MINIO_ROOT_PASSWORD=changeme-minio
MINIO_BUCKET=healthagi
MINIO_SECURE=false

# --- Logging ---
LOG_LEVEL=INFO
