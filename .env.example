# --- Database ---
POSTGRES_USER=healthagi
POSTGRES_PASSWORD=changeme
POSTGRES_DB=healthagi
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://healthagi:changeme@localhost:5432/healthagi
ALEMBIC_DATABASE_URL=postgresql+psycopg://healthagi:changeme@localhost:5432/healthagi

# --- Auth ---
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- LLM ---
# Backend selection: gemini | ollama | mock
#   - gemini : managed Google Gemini API (default when GEMINI_API_KEY is set)
#   - ollama : self-hosted via OLLAMA_BASE_URL
#   - mock   : deterministic stubs for tests
HEALTHAGI_LLM_BACKEND=gemini

# Gemini API key from https://aistudio.google.com/apikey
# GEMINI_API_KEY and GOOGLE_API_KEY are both honored.
GEMINI_API_KEY=

# Models used by the backend.
# Gemini examples (managed API):
#   text:   gemini-2.5-flash | gemini-2.5-pro | gemini-2.0-flash
#   vision: same multimodal Gemini model is reused for image input
#   voice:  same model — keep `flash` here for tighter latency
# Ollama examples (local):
#   text:   gemma3:12b | qwen2.5:7b
#   vision: qwen2-vl:7b | qwen2-vl:2b
#   voice:  gemma3:4b
LLM_TEXT_MODEL=gemini-2.5-flash
LLM_VISION_MODEL=gemini-2.5-flash
LLM_VOICE_MODEL=gemini-2.5-flash

# Only used when HEALTHAGI_LLM_BACKEND=ollama.
OLLAMA_BASE_URL=http://localhost:11434

# --- Voice (STT/TTS) — only consumed when the voice endpoints are exercised ---
# STT backend: whisper | mock (whisper requires `pip install -e .[voice]`)
# HEALTHAGI_STT_BACKEND=whisper
# HEALTHAGI_WHISPER_MODEL=large-v3      # use `medium` on <=8GB VRAM
# HEALTHAGI_WHISPER_COMPUTE=int8_float16
# TTS backend: xtts | piper | mock
# HEALTHAGI_TTS_BACKEND=xtts
# HEALTHAGI_PIPER_VOICE=/models/piper/ko_KR-glow_tts.onnx

# --- Object storage (MinIO) ---
HEALTHAGI_STORAGE_BACKEND=local   # local | minio | memory
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=healthagi
MINIO_ROOT_PASSWORD=changeme-minio
MINIO_BUCKET=healthagi
MINIO_SECURE=false

# --- Logging ---
LOG_LEVEL=INFO
