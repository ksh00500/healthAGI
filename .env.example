# --- Database (PostgreSQL on host port 5435 to avoid colliding with a local pg) ---
POSTGRES_USER=healthagi
POSTGRES_PASSWORD=changeme
POSTGRES_DB=healthagi
POSTGRES_PORT=5435
DATABASE_URL=postgresql+asyncpg://healthagi:changeme@localhost:5435/healthagi
ALEMBIC_DATABASE_URL=postgresql+psycopg://healthagi:changeme@localhost:5435/healthagi

# --- Auth ---
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- LLM ---
# Backend selection: gemini | ollama | mock
#   - gemini : managed Google Gemini API (default when GEMINI_API_KEY is set)
#   - ollama : self-hosted via OLLAMA_BASE_URL
#   - mock   : deterministic stubs for tests
HEALTHAGI_LLM_BACKEND=gemini

# Gemini API key from https://aistudio.google.com/apikey
# Either env name works; only one needs to be set.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Per-feature model tiering. Lighter / cheaper models for high-volume work,
# Pro reserved for the once-a-day analytical pass.
#   chat            : interactive Q&A (streamed)
#   voice           : PTT + streaming voice turn — latency matters most
#   parse           : one-shot structured extraction (workout/meal free text)
#   recommendation  : daily card generation + per-workout recovery suggestion
#   vision          : meal photo analysis
LLM_CHAT_MODEL=gemini-2.5-flash
LLM_VOICE_MODEL=gemini-2.5-flash-lite
LLM_PARSE_MODEL=gemini-2.5-flash
LLM_RECOMMENDATION_MODEL=gemini-2.5-pro
LLM_VISION_MODEL=gemini-2.5-flash

# Legacy alias — if set, overrides LLM_CHAT_MODEL. Leave blank in new setups.
# LLM_TEXT_MODEL=

# Only used when HEALTHAGI_LLM_BACKEND=ollama (e.g. a beefy GPU host).
OLLAMA_BASE_URL=http://localhost:11434

# --- Voice (STT/TTS) — local, CPU-friendly defaults ---
# Audio capture/playback still happens on device; the server only runs
# transcription (Whisper) and synthesis (Piper) when voice endpoints are hit.
# HEALTHAGI_STT_BACKEND=whisper
# HEALTHAGI_WHISPER_MODEL=small         # use `medium` for higher quality
# HEALTHAGI_WHISPER_COMPUTE=int8        # CPU friendly; switch to int8_float16 for GPU
# HEALTHAGI_TTS_BACKEND=piper
# HEALTHAGI_PIPER_VOICE=/models/piper/ko_KR-glow_tts.onnx

# --- Object storage ---
# local : write to ./data/storage on the host filesystem (no MinIO needed)
# minio : S3-compatible (needs the minio container + the MINIO_* settings)
# memory: in-process only, used by tests
HEALTHAGI_STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=healthagi
MINIO_ROOT_PASSWORD=changeme-minio
MINIO_BUCKET=healthagi
MINIO_SECURE=false

# --- Logging ---
LOG_LEVEL=INFO
